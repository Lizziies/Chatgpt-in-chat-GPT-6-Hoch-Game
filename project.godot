; Engine configuration file.
; VOID INDUSTRIES. No plugins, telemetry or network services.
config_version=5

[application]
config/name="VOID INDUSTRIES"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/show_image=false

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.023, 0.033, 0.047, 1)
lights_and_shadows/use_physical_light_units=false

[debug]
file_logging/enable_file_logging=false
settings/stdout/print_fps=false

[physics]
common/physics_ticks_per_second=60
